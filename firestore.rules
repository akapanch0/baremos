rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'jagarcia0109@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Entity validation blueprints
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.legajo is string && data.legajo.size() <= 50 &&
             (!('zona' in data) || (data.zona is string && data.zona.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('creado' in data) || (data.creado is string && data.creado.size() <= 50));
    }

    function isValidJornada(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.legajo is string && data.legajo.size() <= 50 &&
             data.fecha is string && data.fecha.size() <= 10 &&
             data.cerrada is bool &&
             data.total is number &&
             (!('items' in data) || (data.items is list && data.items.size() <= 150)) &&
             (!('observaciones' in data) || (data.observaciones is string && data.observaciones.size() <= 500)) &&
             (!('vehiculo' in data) || (data.vehiculo is string && data.vehiculo.size() <= 100)) &&
             (!('creado' in data) || (data.creado is string && data.creado.size() <= 50)) &&
             (!('actualizado' in data) || (data.actualizado is string && data.actualizado.size() <= 50));
    }

    function isValidCombustible(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.legajo is string && data.legajo.size() <= 50 &&
             data.fecha is string && data.fecha.size() <= 10 &&
             data.monto is number &&
             (!('patente' in data) || (data.patente is string && data.patente.size() <= 20)) &&
             (!('descontar' in data) || data.descontar is bool) &&
             (!('mes' in data) || (data.mes is string && data.mes.size() <= 10)) &&
             (!('creado' in data) || (data.creado is string && data.creado.size() <= 50));
    }

    function isValidQuincena(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.legajo is string && data.legajo.size() <= 50 &&
             data.mes is string && data.mes.size() <= 10 &&
             data.tipo is string && data.tipo.size() <= 20 &&
             data.total is number &&
             (!('fechaRegistro' in data) || (data.fechaRegistro is string && data.fechaRegistro.size() <= 10)) &&
             (!('bloqueada' in data) || data.bloqueada is bool) &&
             (!('creado' in data) || (data.creado is string && data.creado.size() <= 50));
    }

    // 2. User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == userId;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // 3. User Workday Jornadas
      match /jornadas/{jornadaId} {
        allow get, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(jornadaId) && isOwner(userId) && isValidJornada(incoming()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(jornadaId) && (isOwner(userId) || isAdmin()) && isValidJornada(incoming()) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(jornadaId) && (isOwner(userId) || isAdmin());
      }

      // 4. User Fuel Expenses
      match /combustible/{combustibleId} {
        allow get, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(combustibleId) && isOwner(userId) && isValidCombustible(incoming()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(combustibleId) && (isOwner(userId) || isAdmin()) && isValidCombustible(incoming()) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(combustibleId) && (isOwner(userId) || isAdmin());
      }

      // 5. User Fortnight Summaries
      match /quincenas/{quincenaId} {
        allow get, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(quincenaId) && isOwner(userId) && isValidQuincena(incoming()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(quincenaId) && (isOwner(userId) || isAdmin()) && isValidQuincena(incoming()) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(quincenaId) && (isOwner(userId) || isAdmin());
      }
    }

    // 6. System Admins Registry
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
